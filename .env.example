# Supabase project settings (Dashboard → Project Settings → API).
# Only the public anon/publishable key belongs here — these values are bundled
# into the browser build. NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
